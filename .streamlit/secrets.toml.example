# Copy this file to `.streamlit/secrets.toml` and fill in your own values.
# secrets.toml is listed in .gitignore - never commit it.

# Local PostgreSQL (see README for setup). Format:
# postgresql+psycopg2://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL = "postgresql+psycopg2://postgres:CHANGE_ME@localhost:5432/marketdb"

# https://newsapi.org - only needed for the news sentiment section
NEWS_API_KEY = "your_newsapi_key"
