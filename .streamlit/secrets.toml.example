# Copy this file to `.streamlit/secrets.toml` and fill in your own values.
# secrets.toml is listed in .gitignore - never commit it.

# Local PostgreSQL. Format: postgresql+psycopg2://USER:PASSWORD@HOST:PORT/DBNAME
# A default Homebrew install has no password and uses your Mac login as the database user,
# so this works as is after `createdb marketdb`:
DATABASE_URL = "postgresql+psycopg2://localhost:5432/marketdb"
# If your database needs a user and password:
# DATABASE_URL = "postgresql+psycopg2://myuser:mypassword@localhost:5432/marketdb"

# https://newsapi.org - only needed for the news sentiment section (the free plan is enough)
NEWS_API_KEY = "your_newsapi_key"
